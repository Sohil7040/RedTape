{
  "name": "corelith-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node tests/run.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "laser": "RUIDA_ALLOW_WRITES=1 vite",
    "laser:preview": "RUIDA_ALLOW_WRITES=1 vite preview",
    "desktop:install": "npm run build && node scripts/install-desktop.mjs",
    "desktop": "RUIDA_ALLOW_WRITES=1 node server/desktopServer.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
